{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "../.next-naming-acceptance/types/**/*.ts",
    "../.next-naming-acceptance/dev/types/**/*.ts",
    ".next-acceptance/types/**/*.ts",
    ".next-acceptance/dev/types/**/*.ts",
    ".next-home-gallery-acceptance/types/**/*.ts",
    ".next-home-gallery-acceptance/dev/types/**/*.ts",
    "/tmp/task8-next/types/**/*.ts",
    "/tmp/task8-next/dev/types/**/*.ts",
    "/tmp/task8-next-final/types/**/*.ts",
    "/tmp/task8-next-final/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
